+
+static gboolean initialized = FALSE;
+
+#define INITIALIZE_DEBUG_CATEGORY \
+  if (!initialized) { \
+  GST_DEBUG_CATEGORY_INIT (gst_matroska_debug, "matroska", 0, \
+      "Matroska Format parsing library"); \
+    initialized = TRUE; \
